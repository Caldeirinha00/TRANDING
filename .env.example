# Networking
LAN_IP=192.168.1.90
QUESTDB_HOST=${LAN_IP}
QUESTDB_PORT=9009
DRAGONFLY_HOST=${LAN_IP}
DRAGONFLY_PORT=6379
QDRANT_HOST=${LAN_IP}
QDRANT_PORT=6333

# API Keys (LLM & Macro Intelligence)
MISTRAL_API_KEYS="your_mistral_api_key_here"
FMP_API_KEY="your_fmp_api_key_here"
ALPHA_VANTAGE_API_KEY="your_alphavantage_key_here"

# LLM Configuration
LLM_MODEL=ministral-8b-2512
LLM_FALLBACK_MODEL=ministral-3b-2512

# Trading Configuration
DEFAULT_SYMBOLS=["EURUSD"]
MAX_DAILY_DRAWDOWN_PCT=3.0
MAX_TOTAL_DRAWDOWN_PCT=15.0
MAX_SINGLE_TRADE_LOSS_PCT=1.0
MAX_CONCURRENT_POSITIONS=1
MAX_LOT_SIZE=0.50
MAX_TRADES_PER_DAY=15
TWIN_MODE=True
TWIN_SYMBOLS=["EURUSD"]

# MT5 Connection (Optional if using MCP via standard config)
MT5_LOGIN=00000000
MT5_PASSWORD="your_mt5_password"
MT5_SERVER="PepperstoneUK-Demo"

# Analysis Cycle
ANALYSIS_INTERVAL_SECONDS=300
