# MetaTrader 5 (Windows 11)
MT5_TERMINAL_PATH="C:\Program Files\MetaTrader 5\terminal64.exe"
MT5_DATA_PATH="C:\Users\username\AppData\Roaming\MetaQuotes\Terminal\INSTANCE_ID"
MT5_LOGIN=00000000
MT5_PASSWORD="your_mt5_password"
MT5_SERVER="PepperstoneUK-Demo"

# Infraestrutura Docker LAN
DRAGONFLY_HOST="192.168.1.90"
DRAGONFLY_PORT=6379
QUESTDB_HOST="192.168.1.90"
QUESTDB_REST_PORT=9000
QUESTDB_PG_PORT=8812
QUESTDB_ILP_PORT=9009

# Parâmetros Estritos de Risco ESMA (Conta 1.000 EUR)
INITIAL_CAPITAL_EUR=1000.0
MAX_RISK_PER_TRADE_PCT=0.0100
MAX_PORTFOLIO_HEAT_PCT=0.0210
MAX_ACTIVE_RISK_POSITIONS=3
DAILY_DD_KILL_SWITCH_PCT=0.0285
TOTAL_DD_KILL_SWITCH_PCT=0.1950
MAX_SWAP_TO_1R_RATIO=0.1500

# Limiares do Meta-Modelo (Camada 2)
META_MIN_PROBABILITY=0.55
META_HIGH_CONVICTION_PROBABILITY=0.68
META_MIN_EXPECTED_NET_R=0.15

# Notificações Telegram
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
TELEGRAM_CHAT_ID="your_telegram_chat_id"
